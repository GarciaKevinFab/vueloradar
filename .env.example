# ============================================================
# VUELORADAR PERÚ — variables de entorno
# Copia este archivo a `.env` y rellena los valores reales.
# NUNCA comitees `.env`.
# ============================================================

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos: Supabase (PostgreSQL) ---
# Usa el SESSION POOLER (puerto 5432). NUNCA el Transaction Pooler (6543):
# rompe prepared statements y las migrations de Django.
# Formato:
#   postgresql://postgres.<project-ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Si se deja vacío, el proyecto cae a SQLite local (solo dev/tests).
DATABASE_URL=
DB_CONN_MAX_AGE=60
SUPABASE_URL=
SUPABASE_KEY=

# --- Redis (cache de tipo de cambio; broker de Celery desde Fase 2) ---
REDIS_URL=redis://localhost:6379/0

# --- Tipo de cambio ---
# Fallback usado si falla el scraping del tipo de cambio del día.
FX_FALLBACK_USD_PEN=3.80

# --- Scraping ---
# Delays aleatorios entre consultas a la misma fuente (segundos).
SCRAPE_DELAY_MIN=3
SCRAPE_DELAY_MAX=8

# --- Telegram (Fase 3) ---
TELEGRAM_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Anthropic (Fase 4) ---
ANTHROPIC_API_KEY=

# --- Router de IA con respaldo (Fase 4) ---
# Se intentan en orden: Anthropic, Groq, DeepSeek, Ollama. Con todas vacías el
# sistema funciona igual, solo que sin veredicto de compra.
GROQ_API_KEY=
DEEPSEEK_API_KEY=
# Solo dev local. Si está vacío, Ollama ni se intenta.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:8b

# --- Alertas ---
FREE_MAX_ALERTS=2
PREMIUM_MAX_ALERTS=20

# --- Correo (avisos por email) ---
# Sin EMAIL_HOST, Django escribe el mensaje en la CONSOLA y no lo manda a nadie:
# el formulario de avisos parece funcionar pero nadie recibe la confirmación.
# En producción esto tiene que estar puesto.
#
# Resend por SMTP (no hace falta su SDK; Django habla SMTP de fábrica):
#   EMAIL_HOST=smtp.resend.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=resend          <- literalmente la palabra "resend"
#   EMAIL_HOST_PASSWORD=re_xxxxx    <- la API key de Resend
#   EMAIL_USE_TLS=True
# El dominio de DEFAULT_FROM_EMAIL tiene que estar verificado en Resend
# (registros SPF/DKIM en Cloudflare) o los correos caen en spam o se rechazan.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=VueloRadar <avisos@vueloradar.com>
# Un formulario público que manda correo es un vector de spam.
EMAIL_ALERTS_PER_IP_PER_HOUR=5
# URL pública: arma los enlaces de confirmación y baja dentro de los correos.
SITE_BASE_URL=https://vueloradar.com

# --- Cloudflare (purga del caché del borde tras cada barrido) ---
# Token con permiso "Zone > Cache Purge" sobre la zona del sitio. Vacío en
# desarrollo: sin esto la purga simplemente no ocurre y solo se loguea.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# --- Publicidad (AdSense) ---
# Vacío = el sitio no hace NI UNA petición a terceros y los huecos no se
# dibujan. AdSense exige aprobación previa; cargar el script sin cuenta
# aprobada paga la latencia sin mostrar un solo anuncio.
ADSENSE_CLIENT=
# Un slot por ubicación: Google reporta por slot, y un ID único para todo el
# sitio hace imposible saber qué espacio rinde.
ADSENSE_SLOT_HOME=
ADSENSE_SLOT_ROUTE=

# --- Crédito del pie ---
BUILDER_NAME=Star Insights IT by SISAC
BUILDER_URL=https://sisac.pe/

# --- Contacto público ---
# Vacío = no se publica ninguna dirección. Publicar una que rebota es PEOR que
# no publicar ninguna: configuralo recién cuando el buzón exista de verdad
# (Cloudflare → Email Routing, gratis, reenvía a tu Gmail). AdSense revisa que
# se sepa quién opera el sitio, y la Ley 29733 exige un canal para ejercer
# derechos sobre los datos personales.
CONTACT_EMAIL=

# --- Analítica ---
# Cloudflare Web Analytics: gratis, SIN cookies y por eso sin banner de
# consentimiento. Se prefirió a Google Analytics justamente por eso: GA
# obligaría a pedir consentimiento y a contradecir la política de privacidad.
# El token sale de Cloudflare → Analytics & Logs → Web Analytics. Es público
# (viaja en el HTML), no es un secreto. Sin token no se carga nada.
CLOUDFLARE_ANALYTICS_TOKEN=

# --- Producción (Fase 5) ---
# El admin va detrás de un path no obvio.
DJANGO_ADMIN_PATH=admin
LOG_FORMAT=console           # console | json
LOG_LEVEL=INFO
SENTRY_DSN=

# Scrapers directos: pesados y frágiles, apagados por defecto.
ENABLE_SKY_SCRAPER=False
ENABLE_JETSMART_SCRAPER=False
# Ojo: el precio de Sky es tarifa base, sin impuestos. No lo actives sin leer
# la nota en apps/scraping/providers/sky.py.
VERIFY_DEALS_WITH_DIRECT_SCRAPER=False

# Bot
BOT_MODE=polling             # polling | webhook
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=
BOT_GLOBAL_SEARCH_LIMIT=20

# Backups
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=14
# llama-3.3-70b-versatile fue retirado por Groq en 2026.
GROQ_MODEL=
