# ============================================================
# VUELORADAR PERÚ — variables de entorno
# Copia este archivo a `.env` y rellena los valores reales.
# NUNCA comitees `.env`.
# ============================================================

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos: Supabase (PostgreSQL) ---
# Usa el SESSION POOLER (puerto 5432). NUNCA el Transaction Pooler (6543):
# rompe prepared statements y las migrations de Django.
# Formato:
#   postgresql://postgres.<project-ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Si se deja vacío, el proyecto cae a SQLite local (solo dev/tests).
DATABASE_URL=
DB_CONN_MAX_AGE=60
SUPABASE_URL=
SUPABASE_KEY=

# --- Redis (cache de tipo de cambio; broker de Celery desde Fase 2) ---
REDIS_URL=redis://localhost:6379/0

# --- Tipo de cambio ---
# Fallback usado si falla el scraping del tipo de cambio del día.
FX_FALLBACK_USD_PEN=3.80

# --- Scraping ---
# Delays aleatorios entre consultas a la misma fuente (segundos).
SCRAPE_DELAY_MIN=3
SCRAPE_DELAY_MAX=8

# --- Telegram (Fase 3) ---
TELEGRAM_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Anthropic (Fase 4) ---
ANTHROPIC_API_KEY=

# --- Router de IA con respaldo (Fase 4) ---
# Se intentan en orden: Anthropic, Groq, DeepSeek, Ollama. Con todas vacías el
# sistema funciona igual, solo que sin veredicto de compra.
GROQ_API_KEY=
DEEPSEEK_API_KEY=
# Solo dev local. Si está vacío, Ollama ni se intenta.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:8b

# --- Alertas ---
FREE_MAX_ALERTS=2
PREMIUM_MAX_ALERTS=20

# --- Producción (Fase 5) ---
# El admin va detrás de un path no obvio.
DJANGO_ADMIN_PATH=admin
LOG_FORMAT=console           # console | json
LOG_LEVEL=INFO
SENTRY_DSN=

# Scrapers directos: pesados y frágiles, apagados por defecto.
ENABLE_SKY_SCRAPER=False
ENABLE_JETSMART_SCRAPER=False
# Ojo: el precio de Sky es tarifa base, sin impuestos. No lo actives sin leer
# la nota en apps/scraping/providers/sky.py.
VERIFY_DEALS_WITH_DIRECT_SCRAPER=False

# Bot
BOT_MODE=polling             # polling | webhook
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=
BOT_GLOBAL_SEARCH_LIMIT=20

# Backups
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=14
# llama-3.3-70b-versatile fue retirado por Groq en 2026.
GROQ_MODEL=

# --- Precio de venta (si revendes los pasajes) ---
# El margen es el mayor entre el porcentaje y el piso fijo: un 10% sobre un
# pasaje de S/ 150 son S/ 15, que no paga el trabajo de gestionar la compra.
SALE_MARKUP_PCT=10
SALE_MARKUP_MIN_PEN=25
SALE_ROUND_TO_PEN=5
# El desglose con tu ganancia solo lo ve el admin. Ponelo en False si querés
# que todos los usuarios vean el precio de venta.
SHOW_SALE_PRICE_TO_ADMIN_ONLY=True
