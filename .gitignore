.env
.venv/
venv/

# Credenciales pasadas a mano. El sitio para dejarlas es FUERA del repo, pero
# un olvido no puede terminar en un commit publico: una key filtrada en el
# historial de git sigue ahi aunque se borre el archivo despues.
*.key
*.pem
*secret*
*-key.txt
.env.*
!.env.example
__pycache__/
*.py[cod]
*.sqlite3
db.sqlite3
.pytest_cache/
.coverage
htmlcov/
*.log
.idea/
.vscode/

# Artefactos de herramientas y runtime
graphify-out/
celerybeat-schedule*
.ruff_cache/
backups/
scraper_fails/
*.stackdump

# Estaticos generados por collectstatic
staticfiles/

# Credenciales que se pasan a mano; nunca deben versionarse
.cf-token
*.token
